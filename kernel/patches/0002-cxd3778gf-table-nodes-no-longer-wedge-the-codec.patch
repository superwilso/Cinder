+/* Cinder: the codec's global mutex is now held only inside one read() or write() call. Sony's
+ * version took it on the call at offset 0 and released it on the call that reached the end of the
+ * table, so a partial read (`head -c`), a short write, or a process killed in between left every
+ * codec operation (volume, PCM open, standby) blocked until a restart. A write at a non-zero
+ * offset first also used a NULL work buffer. Each open file now gathers its own write and applies
+ * it, under the mutex, once the whole table and its checksum have arrived. */
+static int find_port(struct file * file)
