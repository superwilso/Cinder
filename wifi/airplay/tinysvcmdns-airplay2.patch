--- a/audio_stdout.c
+++ b/audio_stdout.c
@@ -40,6 +40,44 @@
 static int warned = 0;
 static unsigned int bytes_per_frame = 0;
 
+// Cinder: how much audio is queued after this pipe, so AirPlay 2 can keep time. Without a delay()
+// the player never learns it is running behind until it throws audio away (heard as speed-ups).
+// Cinder, which reads the pipe, writes its own queue (frames on the jack plus any in hand) and
+// when it was true into this file; the queue drains at the output rate from then on. Missing (no
+// Cinder, or not on the jack): only what is still in the pipe counts.
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <time.h>
+struct cinder_queue {
+  uint32_t seq;   // equal to seq2 when the record is whole
+  uint32_t frames;
+  int64_t at_ns;  // CLOCK_MONOTONIC
+  uint32_t seq2;
+  uint32_t rate;
+};
+static int cinder_fd = -1;
+
+static int delay(long *the_delay) {
+  long frames = 0;
+  int in_pipe = 0;
+  if (bytes_per_frame && ioctl(fd, FIONREAD, &in_pipe) == 0 && in_pipe > 0)
+    frames += in_pipe / bytes_per_frame;
+  if (cinder_fd < 0)
+    cinder_fd = open("/tmp/cinder_airplay_queue", O_RDONLY | O_CLOEXEC);
+  struct cinder_queue q;
+  if (cinder_fd >= 0 && pread(cinder_fd, &q, sizeof q, 0) == (ssize_t)sizeof q && q.seq == q.seq2 &&
+      q.rate) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const int64_t now = (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+    const int64_t drained = now > q.at_ns ? (now - q.at_ns) * q.rate / 1000000000 : 0;
+    if ((int64_t)q.frames > drained)
+      frames += (long)((int64_t)q.frames - drained);
+  }
+  *the_delay = frames;
+  return 0;
+}
