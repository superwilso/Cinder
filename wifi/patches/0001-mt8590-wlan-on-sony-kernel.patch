--- a/drivers/net/wireless/mt_soc/conn_soc/mt_wifi/wlan/os/linux/gl_wext_stub.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/net/wireless/mt_soc/conn_soc/mt_wifi/wlan/os/linux/gl_wext_stub.c	2026-11-04 23:05:42.053877099 +0000
@@ -0,0 +1,13 @@
+/*
+ * cinder-wifi: Sony's NW-A50 kernel is built without wireless extensions (CONFIG_WIRELESS_EXT and
+ * CONFIG_WEXT_CORE unset), so nothing can receive a wext event and the kernel has no
+ * wireless_send_event(). The driver reports to userspace through cfg80211/nl80211 instead; its
+ * wext events go nowhere, as they would on any kernel with no wext listener.
+ */
+#include <linux/netdevice.h>
+#include <net/iw_handler.h>
+
+void wireless_send_event(struct net_device *dev, unsigned int cmd, union iwreq_data *wrqu,
+                         const char *extra)
+{
+}
